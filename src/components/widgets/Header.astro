---
import Logo from '~/components/atoms/Logo.astro';
import Logo_dark from '~/components/atoms/Logo_dark.astro';
import ToggleTheme from '~/components/core/ToggleTheme.astro';
import ToggleMenu from '~/components/core/ToggleMenu.astro';

import { getHomePermalink } from '~/utils/permalinks';
---

<header
  class="sticky top-0 z-40 flex-none w-full transition-transform duration-300 bg-white md:bg-white/90 dark:bg-neutral-900 dark:md:bg-neutral-900 md:backdrop-blur-sm border-b dark:border-b-0 shadow-[0_20px_40px_-2px_rgba(255,255,255,0.25)] overflow-y-auto md:overflow-visible"
  id="header"
>
  <div class="py-3 px-3 md:flex justify-between">
    <div class="flex justify-between">
      <a href={getHomePermalink()} class="relative flex items-center">
        <!-- Fixed logo area: smaller on phones so it doesn't overflow next to the icons -->
        <div
          class="relative w-[200px] h-[60px] sm:w-[280px] sm:h-[80px] md:w-[400px] md:h-[100px] flex items-center justify-center overflow-hidden"
        >
          <div class="absolute inset-0 flex items-center justify-center dark:hidden">
            <Logo />
          </div>
          <div class="absolute inset-0 items-center justify-center hidden dark:flex">
            <Logo_dark />
          </div>
        </div>
      </a>

      <!-- Mobile only (< md): theme toggle + hamburger -->
      <div class="flex items-center md:hidden">
        <ToggleTheme />
        <ToggleMenu />
      </div>
    </div>

    <!-- Hidden by default; BasicScripts toggles `hidden` on mobile. From md up, md:flex always shows it. -->
    <nav
      class="items-center justify-end w-full hidden md:flex text-neutral-600 dark:text-neutral-200"
      aria-label="Main navigation"
    >
      <!-- No h-screen here: on mobile the header itself becomes h-screen when the menu is open -->
      <ul
        class="flex flex-col pt-8 pb-8 md:py-0 md:flex-row md:self-center text-center md:text-base items-center w-full md:w-auto"
      >
        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/schedule">Schedule</a
          >
        </li>

        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/workshops">Workshops</a
          >
        </li>

        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/conferencebook">Conference Book</a
          >
        </li>

        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/speakers">Speakers</a
          >
        </li>

        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/#travelguide">Travel Guide</a
          >
        </li>

        <li>
          <a
            class="font-medium hover:text-neutral-900 dark:hover:text-white px-4 py-3 flex items-center transition duration-150 ease-in-out"
            href="/#submissions"
            >Submissions
          </a>
        </li>
       
        <li>
          <a
            class="header-link font-medium hover:text-neutral-900 dark:hover:text-white mx-3 px-1 mt-3 mb-2 pb-1 flex items-center transition duration-150 ease-in-out"
            href="/#registration"
            >Registration
          </a>
        </li>

        <!--
        <li>
          <a
            class="font-medium hover:text-neutral-900 dark:hover:text-white px-4 py-3 flex items-center transition duration-150 ease-in-out"
            href="/sponsors">Sponsors</a
          >
        </li>
        -->
      </ul>
    </nav>

    <!-- Desktop only (>= md): theme toggle -->
    <div class="md:self-center flex items-center ml-2">
      <div class="hidden items-center md:flex">
        <ToggleTheme iconClass="w-5 h-5" />
      </div>
    </div>
  </div>
</header>

<style>
  .header-link {
    position: relative;
  }

  .header-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background-color: rgb(187, 172, 0);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .header-link:hover::after,
  .header-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
