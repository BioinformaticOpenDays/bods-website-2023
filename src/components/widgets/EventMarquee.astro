---
const cards = [
	{
		title: 'Life is complex. Data helps us see patterns.',
		copy: 'Bioinformatics brings computational thinking to the questions that matter in life science.',
		tone: 'gold',
	},
	{
		title: 'Different disciplines. Shared curiosity.',
		copy: 'Meet students, researchers and educators who are shaping the future of the field.',
		tone: 'ink',
	},
	{
		title: 'A community built around exchanging ideas.',
		copy: 'Bioinformatics Open Days began at the University of Minho and keeps growing with its community.',
		tone: 'paper',
	},
	{
		title: 'A meeting point for the life sciences.',
		copy: 'Join us at the University of Minho, Gualtar Campus, from 21-23 April 2027.',
		tone: 'amber',
	},
	{
		title: 'Big questions need more than one perspective.',
		copy: 'Bring your curiosity to three days dedicated to bioinformatics and computational biology.',
		tone: 'stone',
	},
];
---

<section class="overflow-hidden bg-neutral-50 dark:bg-neutral-800 py-12 md:mt-5" aria-label="Bioinformatics Open Days highlights">
	<div class="mx-auto mb-7 max-w-6xl px-4 sm:px-6 lg:px-8">
		<h2 class="text-2xl font-bold text-right text-neutral-900 dark:text-white md:text-3xl">Ideas in motion</h2>
	</div>
	<div class="marquee" tabindex="0" aria-label="Highlights from Bioinformatics Open Days">
		<div class="marquee-track">
			<div class="marquee-group">
				{cards.map((card) => (
					<article class={`marquee-card card-${card.tone}`}>
						<div>
							<h3>{card.title}</h3>
							<p class="card-copy">{card.copy}</p>
						</div>
					</article>
				))}
			</div>
			<div class="marquee-group" aria-hidden="true">
				{cards.map((card) => (
					<article class={`marquee-card card-${card.tone}`}>
						<div>
							<h3>{card.title}</h3>
							<p class="card-copy">{card.copy}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
	}

	.marquee:focus-visible {
		outline: 2px solid #eab308;
		outline-offset: -2px;
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-scroll 25s linear infinite;
	}

	.marquee-group {
		display: flex;
		gap: 2rem;
		padding-right: 2rem;
	}

	.marquee:hover .marquee-track,
	.marquee:focus-visible .marquee-track {
		animation-play-state: paused;
	}

	.marquee-card {
		box-sizing: border-box;
		display: flex;
		flex: 0 0 min(82vw, 340px);
		min-height: 200px;
		flex-direction: column;
		justify-content: space-between;
		border-radius: 8px;
		padding: 1.5rem;
        box-shadow: inset 0 0 1rem rgb(0 0 0 / 0.1);
	}

	.card-gold {
		background: #eab308;
		color: #18181b;
	}

	.card-ink {
		background: #18181b;
		color: #fafafa;
	}

	.card-paper {
		border: 1px solid #d4d4d4;
		background: #fff;
		color: #262626;
	}

	.card-amber {
		background: #a16207;
		color: #fff;
	}

	.card-stone {
		background: #404040;
		color: #fafafa;
	}

	.card-number {
		font-size: 0.875rem;
		font-weight: 700;
	}

	.card-label {
		margin-bottom: 0.75rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.marquee-card h3 {
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.card-copy {
		font-size: 0.9375rem;
		line-height: 1.5;
		opacity: 0.85;
	}

	@keyframes marquee-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee {
			overflow-x: auto;
			mask-image: none;
			scrollbar-width: thin;
		}

		.marquee-track {
			animation: none;
		}

		.marquee-group[aria-hidden='true'] {
			display: none;
		}
	}
</style>