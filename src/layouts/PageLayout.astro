---
import Layout from '~/layouts/BaseLayout.astro';
import Header from '~/components/widgets/Header.astro';

const { meta } = Astro.props;
---

<Layout {meta}>
	<Header />
	<main class="min-h-[60vh] flex flex-col antialiased dark:bg-neutral-900 text-gray-900 dark:text-slate-300 tracking-tight bg-white ">
		<slot />
	</main>
</Layout>
